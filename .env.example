# 复制为 .env 后填入 Key（.env 已在 .gitignore 中）
# Provider 容灾链：primary → zhipu → siliconflow，缺 Key 的自动跳过；
# 三家全挂则自动降级到规则基线，服务不中断。

# 1) 主 Provider（任意 OpenAI 兼容接口：DeepSeek / 通义 / Moonshot / 自建 vLLM）
RECON_LLM_BASE_URL=https://api.deepseek.com
RECON_LLM_MODEL=deepseek-chat
RECON_LLM_API_KEY=

# 2) 智谱 GLM-4-Flash（免费，默认第二顺位）
RECON_ZHIPU_API_KEY=

# 3) 硅基流动 Qwen2.5-7B（免费档，默认第三顺位）
RECON_SILICONFLOW_API_KEY=

# 归因门禁：置信度低于该阈值转人工。阈值由 scripts/calibrate.py 校准得出，
# 不是拍的 —— 换模型/换数据后必须重新校准。
RECON_GATE_THRESHOLD=0.85
RECON_LLM_TEMPERATURE=0.1
RECON_LLM_TIMEOUT=60
RECON_LLM_MAX_RETRIES=1
RECON_MIN_INTERVAL_MS=1500
